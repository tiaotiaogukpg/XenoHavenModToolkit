<Window x:Class="XenoHavenModToolkit.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.About.Title}"
        Height="280"
        Width="420"
        MinHeight="240"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="16" Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ProductNameText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.TextColor}"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="VersionText"
                       FontSize="14"
                       Foreground="{DynamicResource Theme.TextColor}"
                       Margin="0,0,0,12"/>
            <TextBlock x:Name="RuntimeText"
                       FontSize="12"
                       Foreground="{DynamicResource Theme.SecondaryTextColor}"
                       Margin="0,0,0,4"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="RunModeText"
                       FontSize="12"
                       Foreground="{DynamicResource Theme.SecondaryTextColor}"
                       Margin="0,0,0,4"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource Str.About.Description}"
                       FontSize="12"
                       Foreground="{DynamicResource Theme.SecondaryTextColor}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Str.Close}" Width="100" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
