<Window x:Class="XenoHavenModToolkit.AddBuildingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增 Building" Height="360" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="id（整数且不重复）" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"/>
            <TextBox x:Name="IdBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Text="name" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"/>
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Text="type" Grid.Row="2" Grid.Column="0" Margin="0,0,8,8"/>
            <TextBox x:Name="TypeBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="Building"/>

            <TextBlock Text="size.x" Grid.Row="3" Grid.Column="0" Margin="0,0,8,8"/>
            <TextBox x:Name="SizeXBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="1"/>

            <TextBlock Text="size.y" Grid.Row="4" Grid.Column="0" Margin="0,0,8,8"/>
            <TextBox x:Name="SizeYBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="1"/>

            <TextBlock Text="health" Grid.Row="5" Grid.Column="0" Margin="0,0,8,8"/>
            <TextBox x:Name="HealthBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Text="100"/>

            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Foreground="#666" TextWrapping="Wrap">
                创建后只会把条目写入编辑器里的 Buildings.xml（不会立刻写磁盘），请再点击主界面的“保存 XML”。
            </TextBlock>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="100" IsCancel="True"/>
            <Button Content="创建" Width="100" IsDefault="True" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>

