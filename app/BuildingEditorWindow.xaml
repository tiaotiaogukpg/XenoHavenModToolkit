<Window x:Class="XenoHavenModToolkit.BuildingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Building 编辑" Height="760" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ImageSectionFoldToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="4">
                            <Path x:Name="Glyph"
                                  Width="8"
                                  Height="8"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource Theme.SecondaryTextColor}"
                                  Data="M2,1 L7,5 L2,9 Z"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialsGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryTextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="MaterialsGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="{DynamicResource Theme.EditorBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.SelectionBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaterialsGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource Theme.EditorBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderColor}"/>
        </Style>

        <Style x:Key="MaterialsGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MaterialsGridEditingTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource Theme.EditorBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.FocusGlow}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.SelectionBackground}"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12" Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Grid.IsSharedSizeScope="True" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="BuildingEditorLabelCol"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="id" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" Margin="0,0,0,8" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="name" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="type" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TypeBox" Margin="0,0,0,8" Text="Building" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="hashId" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="HashIdBox" Margin="0,0,0,8" IsReadOnly="True"
                         VerticalContentAlignment="Center" MinHeight="28"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="direction" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="DirectionBox" Margin="0,0,0,8" Text="1" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="capbility" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="CapbilityBox" Margin="0,0,0,8" Text="1" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="workbenchId" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="WorkbenchIdBox" Margin="0,0,0,8" Text="1" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="health" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="HealthBox" Margin="0,0,0,8" Text="100" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="size.x" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="SizeXBox" Margin="0,0,0,8" Text="1" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="size.y" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="9" Grid.Column="1" x:Name="SizeYBox" Margin="0,0,0,12" Text="1" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="制造公式" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,4,10,0"/>
                <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="新增材料" Click="AddMaterial_Click" Margin="0,0,8,0"/>
                        <Button Content="删除选中" Click="DeleteMaterial_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="MaterialsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MinHeight="32"
                              MaxHeight="120"
                              Background="{DynamicResource Theme.EditorBackground}"
                              Foreground="{DynamicResource Theme.TextColor}"
                              BorderBrush="{DynamicResource Theme.BorderColor}"
                              HorizontalGridLinesBrush="{DynamicResource Theme.BorderColor}"
                              VerticalGridLinesBrush="{DynamicResource Theme.BorderColor}"
                              ColumnHeaderStyle="{StaticResource MaterialsGridColumnHeaderStyle}"
                              CellStyle="{StaticResource MaterialsGridCellStyle}"
                              RowStyle="{StaticResource MaterialsGridRowStyle}"
                              RowHeaderWidth="0"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="材料 id"
                                                Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource MaterialsGridTextStyle}"
                                                EditingElementStyle="{StaticResource MaterialsGridEditingTextBoxStyle}"
                                                Width="*"/>
                            <DataGridTextColumn Header="数量"
                                                Binding="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource MaterialsGridTextStyle}"
                                                EditingElementStyle="{StaticResource MaterialsGridEditingTextBoxStyle}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="NoMaterialsText"
                               Text="（无材料要求）"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"/>
                </StackPanel>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="物品图标" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,12,10,0"/>
                <Button Grid.Row="11" Grid.Column="1"
                        Content="导入物品图标"
                        Click="ImportIconImage_Click"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,4"/>

                <Grid Grid.Row="12" Grid.Column="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="IconPreviewExpandToggle"
                                  Grid.Column="0"
                                  Style="{StaticResource ImageSectionFoldToggleStyle}"
                                  IsChecked="False"
                                  ToolTip="展开/折叠预览"/>
                    <TextBlock x:Name="IconImagePathText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               FontSize="12"/>
                </Grid>

                <Border Grid.Row="13" Grid.Column="1"
                        x:Name="IconImagePreviewHost"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsChecked, ElementName=IconPreviewExpandToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border x:Name="IconImageDropBorder"
                            Height="160"
                            Background="{DynamicResource Theme.EditorBackground}"
                            BorderBrush="{DynamicResource Theme.BorderColor}"
                            BorderThickness="1"
                            AllowDrop="True"
                            DragEnter="IconImage_DragEnter"
                            DragLeave="IconImage_DragLeave"
                            Drop="IconImage_Drop"
                            MouseLeftButtonUp="IconImage_Click">
                        <Image x:Name="IconImagePreview" Stretch="Uniform"/>
                    </Border>
                </Border>

                <TextBlock Grid.Row="14" Grid.Column="0" Text="地图显示图" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,4,10,0"/>
                <Button Grid.Row="14" Grid.Column="1"
                        Content="导入地图显示图"
                        Click="ImportWorldImage_Click"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,4"/>

                <Grid Grid.Row="15" Grid.Column="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="WorldPreviewExpandToggle"
                                  Grid.Column="0"
                                  Style="{StaticResource ImageSectionFoldToggleStyle}"
                                  IsChecked="False"
                                  ToolTip="展开/折叠预览"/>
                    <TextBlock x:Name="WorldImagePathText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               FontSize="12"/>
                </Grid>

                <Border Grid.Row="16" Grid.Column="1"
                        x:Name="WorldImagePreviewHost"
                        Visibility="{Binding IsChecked, ElementName=WorldPreviewExpandToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border x:Name="WorldImageDropBorder"
                            Height="160"
                            Background="{DynamicResource Theme.EditorBackground}"
                            BorderBrush="{DynamicResource Theme.BorderColor}"
                            BorderThickness="1"
                            AllowDrop="True"
                            DragEnter="WorldImage_DragEnter"
                            DragLeave="WorldImage_DragLeave"
                            Drop="WorldImage_Drop"
                            MouseLeftButtonUp="WorldImage_Click">
                        <Image x:Name="WorldImagePreview" Stretch="Uniform"/>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="100" IsCancel="True"/>
            <Button Content="保存" Width="100" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>

