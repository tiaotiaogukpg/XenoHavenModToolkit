<Window x:Class="XenoHavenModToolkit.BuildingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Building 编辑" Height="760" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="12" Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Grid.IsSharedSizeScope="True" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="BuildingEditorLabelCol"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="id" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" Margin="0,0,0,8" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="type" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TypeBox" Margin="0,0,0,8" Text="Building" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="name" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="direction" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="DirectionBox" Margin="0,0,0,8" Text="1" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="capbility" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="CapbilityBox" Margin="0,0,0,8" Text="1" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="workbenchId" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="WorkbenchIdBox" Margin="0,0,0,8" Text="1" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="health" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="HealthBox" Margin="0,0,0,8" Text="100" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="size.x" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="SizeXBox" Margin="0,0,0,8" Text="1" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="size.y" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="SizeYBox" Margin="0,0,0,12" Text="1" VerticalContentAlignment="Center" MinHeight="28"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="地图显示图" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,10,0"/>
                <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,0,0,14">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="导入地图图"
                                Click="ImportWorldImage_Click"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="0,0,8,0"/>
                        <TextBlock x:Name="WorldImagePathText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Theme.SecondaryTextColor}"
                                   FontSize="12"/>
                    </Grid>
                    <Border x:Name="WorldImageDropBorder"
                            Height="160"
                            Background="{DynamicResource Theme.EditorBackground}"
                            BorderBrush="{DynamicResource Theme.BorderColor}"
                            BorderThickness="1"
                            AllowDrop="True"
                            DragEnter="WorldImage_DragEnter"
                            DragLeave="WorldImage_DragLeave"
                            Drop="WorldImage_Drop"
                            MouseLeftButtonUp="WorldImage_Click">
                        <Image x:Name="WorldImagePreview" Stretch="Uniform"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="物品图标" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,10,0"/>
                <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,0,0,0">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="导入物品图标"
                                Click="ImportIconImage_Click"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="0,0,8,0"/>
                        <TextBlock x:Name="IconImagePathText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Theme.SecondaryTextColor}"
                                   FontSize="12"/>
                    </Grid>
                    <Border x:Name="IconImageDropBorder"
                            Height="160"
                            Background="{DynamicResource Theme.EditorBackground}"
                            BorderBrush="{DynamicResource Theme.BorderColor}"
                            BorderThickness="1"
                            AllowDrop="True"
                            DragEnter="IconImage_DragEnter"
                            DragLeave="IconImage_DragLeave"
                            Drop="IconImage_Drop"
                            MouseLeftButtonUp="IconImage_Click">
                        <Image x:Name="IconImagePreview" Stretch="Uniform"/>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="100" IsCancel="True"/>
            <Button Content="保存到 Buildings.xml" Width="160" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
