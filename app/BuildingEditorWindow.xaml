<Window x:Class="XenoHavenModToolkit.BuildingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Building 编辑" Height="680" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="12" Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Text="id"/>
            <TextBox x:Name="IdBox" Grid.Row="0" Grid.Column="1" Margin="0,0,16,8"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,8,8" Text="type"/>
            <TextBox x:Name="TypeBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" Text="Building"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" Text="name"/>
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" Text="direction"/>
            <TextBox x:Name="DirectionBox" Grid.Row="2" Grid.Column="1" Margin="0,0,16,8" Text="1"/>

            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,0,8,8" Text="capbility"/>
            <TextBox x:Name="CapbilityBox" Grid.Row="2" Grid.Column="3" Margin="0,0,0,8" Text="1"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" Text="workbenchId"/>
            <TextBox x:Name="WorkbenchIdBox" Grid.Row="3" Grid.Column="1" Margin="0,0,16,8" Text="1"/>

            <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,0,8,8" Text="health"/>
            <TextBox x:Name="HealthBox" Grid.Row="3" Grid.Column="3" Margin="0,0,0,8" Text="100"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" Text="size.x"/>
            <TextBox x:Name="SizeXBox" Grid.Row="4" Grid.Column="1" Margin="0,0,16,8" Text="1"/>

            <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,0,8,8" Text="size.y"/>
            <TextBox x:Name="SizeYBox" Grid.Row="4" Grid.Column="3" Margin="0,0,0,8" Text="1"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Foreground="{DynamicResource Theme.SecondaryTextColor}" TextWrapping="Wrap" Margin="0,4,0,8">
                保存后会自动更新 Buildings.xml 并写入磁盘。
            </TextBlock>

            <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Content="导入地图图" Click="ImportWorldImage_Click" Margin="0,0,0,6"/>
                <Border x:Name="WorldImageDropBorder"
                        Grid.Row="1"
                        Grid.Column="0"
                        Background="{DynamicResource Theme.EditorBackground}"
                        BorderBrush="{DynamicResource Theme.BorderColor}"
                        BorderThickness="1"
                        AllowDrop="True"
                        DragEnter="WorldImage_DragEnter"
                        DragLeave="WorldImage_DragLeave"
                        Drop="WorldImage_Drop"
                        MouseLeftButtonUp="WorldImage_Click">
                    <Image x:Name="WorldImagePreview" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="WorldImagePathText" Grid.Row="2" Grid.Column="0" Margin="0,4,0,0" TextWrapping="Wrap"/>

                <Button Grid.Row="0" Grid.Column="2" Content="导入物品图标" Click="ImportIconImage_Click" Margin="0,0,0,6"/>
                <Border x:Name="IconImageDropBorder"
                        Grid.Row="1"
                        Grid.Column="2"
                        Background="{DynamicResource Theme.EditorBackground}"
                        BorderBrush="{DynamicResource Theme.BorderColor}"
                        BorderThickness="1"
                        AllowDrop="True"
                        DragEnter="IconImage_DragEnter"
                        DragLeave="IconImage_DragLeave"
                        Drop="IconImage_Drop"
                        MouseLeftButtonUp="IconImage_Click">
                    <Image x:Name="IconImagePreview" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="IconImagePathText" Grid.Row="2" Grid.Column="2" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="100" IsCancel="True"/>
            <Button Content="保存到 Buildings.xml" Width="160" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>

