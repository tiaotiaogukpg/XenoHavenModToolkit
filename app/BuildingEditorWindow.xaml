<Window x:Class="XenoHavenModToolkit.BuildingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:XenoHavenModToolkit.Controls"
        Title="{DynamicResource Str.BuildingEditor.Title}" Height="760" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="EditorFieldStyle" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="EditorSectionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="EditorHintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryTextColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ImageSectionFoldToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="4">
                            <Path x:Name="Glyph"
                                  Width="8"
                                  Height="8"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource Theme.SecondaryTextColor}"
                                  Data="M2,1 L7,5 L2,9 Z"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialsGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryTextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="MaterialsGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="{DynamicResource Theme.EditorBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.SelectionBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaterialsGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource Theme.EditorBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderColor}"/>
        </Style>

        <Style x:Key="MaterialsGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MaterialsGridEditingTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource Theme.EditorBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.FocusGlow}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.SelectionBackground}"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style x:Key="BarrierOnOffSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="开 = 实体碰撞（不可穿过）；关 = 可穿过"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    CornerRadius="12"
                                    Background="{DynamicResource Theme.ButtonBackground}"
                                    BorderBrush="{DynamicResource Theme.BorderColor}"
                                    BorderThickness="1"/>
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"
                                     Fill="{DynamicResource Theme.SecondaryTextColor}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Theme.SelectionBackground}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Theme.FocusGlow}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Theme.TextColor}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Theme.FocusGlow}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageDropBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="160"/>
            <Setter Property="Background" Value="{DynamicResource Theme.EditorBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16" Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Grid.IsSharedSizeScope="True" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="BuildingEditorLabelCol" MaxWidth="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="id" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" Style="{StaticResource EditorTextBoxStyle}" IsReadOnly="True"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="name" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" Style="{StaticResource EditorTextBoxStyle}"/>

                <controls:BuildingFieldPicker Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="FieldPicker" HorizontalAlignment="Stretch"/>

                <TextBlock Grid.Row="3" Grid.Column="0" x:Name="CapbilityLabel" Text="capbility" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="CapbilityBox" Style="{StaticResource EditorTextBoxStyle}" Text="16"
                         ToolTip="容量范围：16–96"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="health" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="HealthBox" Style="{StaticResource EditorTextBoxStyle}" Text="10" IsReadOnly="True"
                         ToolTip="生命值固定为 10"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="size.x" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="SizeXBox" Style="{StaticResource EditorTextBoxStyle}" Text="1"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="size.y" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="SizeYBox" Style="{StaticResource EditorTextBoxStyle}" Text="1"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource Str.BuildingEditor.Collision}" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="是否具备实体碰撞（不可穿过）"/>
                <StackPanel Grid.Row="7" Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,8"
                            MinHeight="32"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.BuildingEditor.Off}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Style="{StaticResource EditorHintTextStyle}"/>
                    <ToggleButton x:Name="BarrierToggle"
                                  Style="{StaticResource BarrierOnOffSwitchStyle}"/>
                    <TextBlock Text="{DynamicResource Str.BuildingEditor.On}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Style="{StaticResource EditorHintTextStyle}"/>
                </StackPanel>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource Str.BuildingEditor.Recipe}" Style="{DynamicResource BuildingEditorLabelStyle}" VerticalAlignment="Top"/>
                <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{DynamicResource Str.BuildingEditor.AddMaterial}" Style="{StaticResource EditorSectionButtonStyle}" Click="AddMaterial_Click" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource Str.BuildingEditor.DeleteSelected}" Style="{StaticResource EditorSectionButtonStyle}" Click="DeleteMaterial_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="MaterialsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MinHeight="32"
                              MaxHeight="120"
                              Background="{DynamicResource Theme.EditorBackground}"
                              Foreground="{DynamicResource Theme.TextColor}"
                              BorderBrush="{DynamicResource Theme.BorderColor}"
                              HorizontalGridLinesBrush="{DynamicResource Theme.BorderColor}"
                              VerticalGridLinesBrush="{DynamicResource Theme.BorderColor}"
                              ColumnHeaderStyle="{StaticResource MaterialsGridColumnHeaderStyle}"
                              CellStyle="{StaticResource MaterialsGridCellStyle}"
                              RowStyle="{StaticResource MaterialsGridRowStyle}"
                              RowHeaderWidth="0"
                              SelectionMode="Single">
                        <DataGrid.Columns/>
                    </DataGrid>
                    <TextBlock x:Name="NoMaterialsText"
                               Text="{DynamicResource Str.BuildingEditor.NoMaterials}"
                               Margin="0,4,0,0"
                               Style="{StaticResource EditorHintTextStyle}"/>
                </StackPanel>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource Str.BuildingEditor.InventoryIcon}" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <Button Grid.Row="9" Grid.Column="1"
                        Content="{DynamicResource Str.BuildingEditor.ImportInventoryIcon}"
                        Style="{StaticResource EditorSectionButtonStyle}"
                        Click="ImportIconImage_Click"
                        Margin="0,0,0,8"/>

                <Grid Grid.Row="10" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="IconPreviewExpandToggle"
                                  Grid.Column="0"
                                  Style="{StaticResource ImageSectionFoldToggleStyle}"
                                  IsChecked="False"
                                  ToolTip="展开/折叠预览"/>
                    <TextBlock x:Name="IconImagePathText"
                               Grid.Column="1"
                               Style="{StaticResource EditorHintTextStyle}"/>
                </Grid>

                <Border Grid.Row="11" Grid.Column="1"
                        x:Name="IconImagePreviewHost"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsChecked, ElementName=IconPreviewExpandToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border x:Name="IconImageDropBorder"
                            Style="{StaticResource ImageDropBorderStyle}"
                            DragEnter="IconImage_DragEnter"
                            DragLeave="IconImage_DragLeave"
                            Drop="IconImage_Drop"
                            MouseLeftButtonUp="IconImage_Click">
                        <Image x:Name="IconImagePreview" Stretch="Uniform"/>
                    </Border>
                </Border>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="{DynamicResource Str.BuildingEditor.BuildingImage}" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <Button Grid.Row="12" Grid.Column="1"
                        Content="{DynamicResource Str.BuildingEditor.ImportBuildingImage}"
                        Style="{StaticResource EditorSectionButtonStyle}"
                        Click="ImportWorldImage_Click"
                        Margin="0,0,0,8"/>

                <Grid Grid.Row="13" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="WorldPreviewExpandToggle"
                                  Grid.Column="0"
                                  Style="{StaticResource ImageSectionFoldToggleStyle}"
                                  IsChecked="False"
                                  ToolTip="展开/折叠预览"/>
                    <TextBlock x:Name="WorldImagePathText"
                               Grid.Column="1"
                               Style="{StaticResource EditorHintTextStyle}"/>
                </Grid>

                <Border Grid.Row="14" Grid.Column="1"
                        x:Name="WorldImagePreviewHost"
                        Visibility="{Binding IsChecked, ElementName=WorldPreviewExpandToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border x:Name="WorldImageDropBorder"
                            Style="{StaticResource ImageDropBorderStyle}"
                            DragEnter="WorldImage_DragEnter"
                            DragLeave="WorldImage_DragLeave"
                            Drop="WorldImage_Drop"
                            MouseLeftButtonUp="WorldImage_Click">
                        <Image x:Name="WorldImagePreview" Stretch="Uniform"/>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Str.Save}" Width="100" MinHeight="32" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="{DynamicResource Str.Cancel}" Width="100" MinHeight="32" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
