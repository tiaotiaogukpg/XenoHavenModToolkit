<Window x:Class="XenoHavenModToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XenoHaven MOD Toolkit" Height="760" Width="1220"
        MinHeight="640" MinWidth="980"
        Background="{DynamicResource Theme.WindowBackground}">
    <Window.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryTextColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Theme.PanelBackground}"
                BorderBrush="{DynamicResource Theme.BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- 未打开 Mod 时显示 -->
                    <Button x:Name="NewModButton" Content="新建 Mod" Click="NewMod_Click"/>
                    <Button x:Name="CleanMetaButton" Content="清理 .meta" Click="CleanMeta_Click"/>

                    <!-- 已打开 Mod 后显示（顺序按需求） -->
                    <Button x:Name="ModInfoButton" Content="Mod 信息" Click="ModInfo_Click" Visibility="Collapsed"/>
                    <Button x:Name="ValidateXmlButton" Content="校验 XML" Click="ValidateXml_Click" Visibility="Collapsed"/>
                    <Button x:Name="SaveXmlButton" Content="保存 XML" Click="SaveXml_Click" Visibility="Collapsed"/>
                    <Button x:Name="CleanMetaOpenedButton" Content="清理 .meta" Click="CleanMeta_Click" Visibility="Collapsed"/>
                    <Button x:Name="ExportReleaseButton" Content="导出发布版" Click="ExportRelease_Click" Visibility="Collapsed"/>
                </WrapPanel>

            <TextBlock x:Name="CurrentModPathText"
                       Grid.Column="1"
                       Text="未打开 Mod 文件夹"
                       Margin="12,0"
                       Foreground="{DynamicResource Theme.SecondaryTextColor}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>

                <!-- 设置常驻最右边 -->
                <Button x:Name="SettingsButton" Grid.Column="2" Content="设置" Click="Settings_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="MOD EXPLORER" Style="{StaticResource SectionTitleStyle}"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="刷新" Click="RefreshOverview_Click"/>
                            <Button Content="打开所选 Mod" Click="OpenSelectedOverviewMod_Click"/>
                        </StackPanel>
                        <ListBox x:Name="ModOverviewList"
                                 DisplayMemberPath="DisplayName"
                                 PreviewMouseDown="ModOverviewList_PreviewMouseDown"
                                 SelectionChanged="ModOverviewList_SelectionChanged"
                                 MouseDoubleClick="ModOverviewList_DoubleClick"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}" Margin="0,8,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="当前 Mod（Buildings 关联树）" Style="{StaticResource SectionTitleStyle}"/>
                        <TreeView x:Name="ModFileTree"
                                  SelectedItemChanged="ModFileTree_SelectedItemChanged"/>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Theme.BorderColor}"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}" Padding="0">
                <TabControl x:Name="XmlTabs" BorderThickness="0">
                    <TabItem Header="main.xml">
                        <TextBox x:Name="MainXmlEditor"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 BorderThickness="0"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </TabItem>
                    <TabItem Header="Thing/Buildings/Buildings.xml">
                        <TextBox x:Name="BuildingsXmlEditor"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 BorderThickness="0"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Theme.BorderColor}"
                          ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Column="4" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="INSPECTOR / Building 条目" Style="{StaticResource SectionTitleStyle}"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="新增 Building" Click="AddBuilding_Click"/>
                            <Button Content="从 Buildings.xml 重新解析" Click="ReloadBuildings_Click"/>
                        </StackPanel>
                        <ListBox x:Name="BuildingList"
                                 DisplayMemberPath="DisplayName"
                                 SelectionChanged="BuildingList_SelectionChanged"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="图片预览（按 id 映射）" Style="{StaticResource SectionTitleStyle}"/>

                        <WrapPanel Grid.Row="1" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <Button Content="导入地图图"
                                    Click="ImportWorldImage_Click"
                                    Padding="6,2"
                                    Margin="0,0,8,0"
                                    MinWidth="92"/>
                            <Button Content="导入物品图标"
                                    Click="ImportIconImage_Click"
                                    Padding="6,2"
                                    Margin="0,0,0,0"
                                    MinWidth="108"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="2" x:Name="WorldImagePathText" Text="地图显示图：未选择建筑"/>
                        <Border x:Name="WorldImageDropBorder"
                                Grid.Row="3"
                                Background="{DynamicResource Theme.EditorBackground}"
                                BorderBrush="{DynamicResource Theme.BorderColor}"
                                BorderThickness="1"
                                Margin="0,4,0,8"
                                AllowDrop="True"
                                DragEnter="WorldImage_DragEnter"
                                DragLeave="WorldImage_DragLeave"
                                Drop="WorldImage_Drop"
                                MouseLeftButtonUp="WorldImage_Click">
                            <Image x:Name="WorldImagePreview" Stretch="Uniform"/>
                        </Border>

                        <TextBlock Grid.Row="4" x:Name="IconImagePathText" Text="物品图标：未选择建筑"/>
                        <Border x:Name="IconImageDropBorder"
                                Grid.Row="5"
                                Background="{DynamicResource Theme.EditorBackground}"
                                BorderBrush="{DynamicResource Theme.BorderColor}"
                                BorderThickness="1"
                                Margin="0,4,0,0"
                                AllowDrop="True"
                                DragEnter="IconImage_DragEnter"
                                DragLeave="IconImage_DragLeave"
                                Drop="IconImage_Drop"
                                MouseLeftButtonUp="IconImage_Click">
                            <Image x:Name="IconImagePreview" Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SectionBorderStyle}" Margin="8,0,8,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CONSOLE / 日志 / 校验结果" Style="{StaticResource SectionTitleStyle}"/>
                <TextBox x:Name="LogBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         Background="{DynamicResource Theme.ConsoleBackground}"
                         Foreground="{DynamicResource Theme.ConsoleTextColor}"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
