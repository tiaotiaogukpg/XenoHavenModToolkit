<Window x:Class="XenoHavenModToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XenoHaven MOD Toolkit" Height="760" Width="1220"
        MinHeight="640" MinWidth="980">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="打开 Mod 文件夹" Click="OpenModFolder_Click"/>
                <Button Content="校验 XML" Click="ValidateXml_Click"/>
                <Button Content="保存 XML" Click="SaveXml_Click"/>
                <Button Content="导入地图图" Click="ImportWorldImage_Click"/>
                <Button Content="导入物品图标" Click="ImportIconImage_Click"/>
                <Button Content="清理 .meta" Click="CleanMeta_Click"/>
                <Button Content="导出发布版" Click="ExportRelease_Click"/>
            </StackPanel>
            <TextBlock x:Name="CurrentModPathText"
                       DockPanel.Dock="Right"
                       Text="未打开 Mod 文件夹"
                       Margin="16,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Mod 文件" Grid.Column="0" Margin="0,0,8,0">
                <TreeView x:Name="ModFileTree"
                          SelectedItemChanged="ModFileTree_SelectedItemChanged"/>
            </GroupBox>

            <TabControl Grid.Column="1" x:Name="XmlTabs">
                <TabItem Header="main.xml">
                    <TextBox x:Name="MainXmlEditor"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="14"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
                </TabItem>
                <TabItem Header="Thing/Buildings/Buildings.xml">
                    <TextBox x:Name="BuildingsXmlEditor"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="14"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
                </TabItem>
            </TabControl>

            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Header="建筑条目">
                    <ListBox x:Name="BuildingList"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="BuildingList_SelectionChanged"/>
                </GroupBox>

                <GroupBox Header="图片预览（按 id 映射）" Grid.Row="1" Margin="0,8,0,0">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="WorldImagePathText" Text="地图显示图：未选择建筑"/>
                        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" Margin="0,4,0,8">
                            <Image x:Name="WorldImagePreview" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Row="2" x:Name="IconImagePathText" Text="物品图标：未选择建筑"/>
                        <Border Grid.Row="3" BorderBrush="#CCC" BorderThickness="1" Margin="0,4,0,0">
                            <Image x:Name="IconImagePreview" Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <GroupBox Grid.Row="2" Header="日志 / 校验结果" Margin="8">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"/>
        </GroupBox>
    </Grid>
</Window>
