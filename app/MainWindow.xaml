<Window x:Class="XenoHavenModToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XenoHaven MOD Toolkit" Height="760" Width="1220"
        MinHeight="640" MinWidth="980"
        Background="{DynamicResource Theme.WindowBackground}">
    <Window.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryTextColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Theme.PanelBackground}"
                BorderBrush="{DynamicResource Theme.BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button x:Name="OpenModButton" Content="打开工程" Click="OpenModFolder_Click"/>
                    <Button x:Name="NewModButton" Content="新建MOD" Click="NewMod_Click"/>
                    <Button x:Name="CleanMetaButton" Content="清理 .meta" Click="CleanMeta_Click" Visibility="Collapsed"/>

                    <Button x:Name="ModInfoButton" Content="编辑MOD" Click="ModInfo_Click" IsEnabled="False"/>
                    <Button x:Name="AddBuildingButton" Content="新建组件" Click="AddBuilding_Click" IsEnabled="False"/>
                    <Button x:Name="EditBuildingButton" Content="编辑组件" Click="OpenBuildingEditor_Click" IsEnabled="False"/>
                    <Button x:Name="DeleteBuildingButton" Content="删除组件" Click="DeleteBuilding_Click" IsEnabled="False"/>
                    <Button x:Name="DeleteModButton" Content="删除MOD" Click="DeleteMod_Click" IsEnabled="False"/>
                    <Button x:Name="CleanMetaOpenedButton" Content="清理 .meta" Click="CleanMeta_Click" Visibility="Collapsed"/>
                </WrapPanel>

            <TextBlock x:Name="CurrentModPathText"
                       Grid.Column="1"
                       Text="未打开 Mod 文件夹"
                       Margin="12,0"
                       Foreground="{DynamicResource Theme.SecondaryTextColor}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>

                <!-- 设置常驻最右边 -->
                <Button x:Name="SettingsButton" Grid.Column="2" Content="设置" Click="Settings_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Border Style="{StaticResource SectionBorderStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="刷新" Click="RefreshOverview_Click"/>
                        </StackPanel>
                        <TreeView x:Name="ModFileTree"
                                  SelectedItemChanged="ModFileTree_SelectedItemChanged"
                                  PreviewMouseDown="ModFileTree_PreviewMouseDown"
                                  MouseDoubleClick="ModFileTree_MouseDoubleClick"/>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Theme.BorderColor}"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}">
                <DockPanel>
                    <ListBox x:Name="BuildingTiles"
                             Background="{DynamicResource Theme.PanelBackground}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="BuildingTiles_SelectionChanged"
                             MouseDoubleClick="BuildingTiles_DoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Margin" Value="6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Top"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="256">
                                    <Border Width="256"
                                            Height="256"
                                            Background="{DynamicResource Theme.EditorBackground}"
                                            BorderBrush="{DynamicResource Theme.BorderColor}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <Image Source="{Binding IconImage}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding TileLabel}"
                                               Margin="0,6,0,0"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Theme.TextColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SectionBorderStyle}" Margin="8,0,8,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CONSOLE / 日志 / 校验结果" Style="{StaticResource SectionTitleStyle}"/>
                <TextBox x:Name="LogBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         Background="{DynamicResource Theme.ConsoleBackground}"
                         Foreground="{DynamicResource Theme.ConsoleTextColor}"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
