<Window x:Class="XenoHavenModToolkit.ModInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod 信息" Height="520" Width="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Text="name"/>
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" Text="auth"/>
        <TextBox x:Name="AuthorBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" Text="version"/>
        <TextBox x:Name="VersionBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="1.0.0"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" Text="specifications"/>
        <TextBox x:Name="SpecBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="0.0.1"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" Text="description"/>
        <TextBox x:Name="DescriptionBox"
                 Grid.Row="4" Grid.Column="1"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 MinHeight="200"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="100" IsCancel="True"/>
            <Button Content="生成 XML" Width="120" IsDefault="True" Click="Generate_Click"/>
        </StackPanel>
    </Grid>
</Window>

