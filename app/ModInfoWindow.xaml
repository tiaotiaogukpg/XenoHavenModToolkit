<Window x:Class="XenoHavenModToolkit.ModInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑MOD" Height="700" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="ImageSectionFoldToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="4">
                            <Path x:Name="Glyph"
                                  Width="8"
                                  Height="8"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource Theme.SecondaryTextColor}"
                                  Data="M2,1 L7,5 L2,9 Z"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1177BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1177BB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#0B4F7A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16" Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModFormLabelCol" MaxWidth="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="id" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="MOD 基础值，创建后不可改"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" Margin="0,0,0,8" MinHeight="32" IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="steamPublishedFileId" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="Steam 创意工坊 ID，无则为 0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SteamPublishedFileIdBox" Margin="0,0,0,8" MinHeight="32"
                         Text="0" IsReadOnly="True" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="supportVersion" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="固定为 1，不可改"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SupportVersionBox" Text="1" Margin="0,0,0,8" MinHeight="32"
                         IsReadOnly="True" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="name" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="auth" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="AuthorBox" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="version" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="默认游戏最新版（目前 1.0.0）"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="VersionBox" Text="1.0.0" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"
                         ToolTip="默认游戏最新版（目前 1.0.0）"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="category" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="用于总览树分类显示"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="CategoryBox" Text="Building" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="description" Style="{DynamicResource BuildingEditorLabelStyle}"
                           VerticalAlignment="Top" Margin="0,6,10,0" ToolTip="必填"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="DescriptionBox"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         MinHeight="120"
                         Margin="0,0,0,8"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="icon.png" Style="{DynamicResource BuildingEditorLabelStyle}" Margin="0,12,10,0"
                           ToolTip="MOD 图标，保存到 MOD 根目录"/>
                <Button Grid.Row="8" Grid.Column="1"
                        Content="导入/替换 MOD 图标"
                        Click="ImportIcon_Click"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,4"/>

                <Grid Grid.Row="9" Grid.Column="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="IconPreviewExpandToggle"
                                  Grid.Column="0"
                                  Style="{StaticResource ImageSectionFoldToggleStyle}"
                                  IsChecked="False"
                                  ToolTip="展开/折叠预览"/>
                    <TextBlock x:Name="IconPathText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               FontSize="12"/>
                </Grid>

                <Border Grid.Row="10" Grid.Column="1"
                        x:Name="IconImagePreviewHost"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsChecked, ElementName=IconPreviewExpandToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Height="160"
                            Background="{DynamicResource Theme.EditorBackground}"
                            BorderBrush="{DynamicResource Theme.BorderColor}"
                            BorderThickness="1"
                            MouseLeftButtonUp="ImportIcon_Click">
                        <Image x:Name="IconImagePreview" Stretch="Uniform"/>
                    </Border>
                </Border>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="screenshot.png" Style="{DynamicResource BuildingEditorLabelStyle}" Margin="0,4,10,0"
                           ToolTip="MOD 截图，保存到 MOD 根目录"/>
                <Button Grid.Row="11" Grid.Column="1"
                        Content="导入/替换 MOD 截图"
                        Click="ImportScreenshot_Click"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,4"/>

                <Grid Grid.Row="12" Grid.Column="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ScreenshotPreviewExpandToggle"
                                  Grid.Column="0"
                                  Style="{StaticResource ImageSectionFoldToggleStyle}"
                                  IsChecked="False"
                                  ToolTip="展开/折叠预览"/>
                    <TextBlock x:Name="ScreenshotPathText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               FontSize="12"/>
                </Grid>

                <Border Grid.Row="13" Grid.Column="1"
                        x:Name="ScreenshotImagePreviewHost"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsChecked, ElementName=ScreenshotPreviewExpandToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Height="160"
                            Background="{DynamicResource Theme.EditorBackground}"
                            BorderBrush="{DynamicResource Theme.BorderColor}"
                            BorderThickness="1"
                            MouseLeftButtonUp="ImportScreenshot_Click">
                        <Image x:Name="ScreenshotImagePreview" Stretch="Uniform"/>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="save" Width="120" IsDefault="True" Click="Generate_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>
            <Button Content="cancel" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
