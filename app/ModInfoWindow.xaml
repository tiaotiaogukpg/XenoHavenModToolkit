<Window x:Class="XenoHavenModToolkit.ModInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑MOD" Height="660" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="16" Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="guid（用于唯一标识 Mod）" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,14">
                    <TextBox x:Name="GuidBox" Margin="0,0,8,0" IsReadOnly="True"/>
                    <Button Content="重新生成" Width="100" Click="RegenerateGuid_Click"/>
                </DockPanel>

                <TextBlock Text="name" Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,14"/>

                <TextBlock Text="auth" Margin="0,0,0,6"/>
                <TextBox x:Name="AuthorBox" Margin="0,0,0,14"/>

                <TextBlock Text="version" Margin="0,0,0,6"/>
                <TextBox x:Name="VersionBox" Text="1.0.0" Margin="0,0,0,14"/>

                <TextBlock Text="specifications" Margin="0,0,0,6"/>
                <TextBox x:Name="SpecBox" Text="0.0.1" Margin="0,0,0,14"/>

                <TextBlock Text="description（必填）" Margin="0,0,0,6"/>
                <TextBox x:Name="DescriptionBox"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         MinHeight="160"
                         Margin="0,0,0,14"/>

                <TextBlock Text="MOD 图标 icon.png（必填，固定保存到 MOD 根目录）" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock x:Name="IconPathText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Content="导入/替换" Width="100" Margin="8,0,0,0" DockPanel.Dock="Right" Click="ImportIcon_Click"/>
                </DockPanel>

                <TextBlock Text="MOD 截图 screenshot.png（必填，固定保存到 MOD 根目录）" Margin="0,0,0,6"/>
                <DockPanel>
                    <TextBlock x:Name="ScreenshotPathText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Content="导入/替换" Width="100" Margin="8,0,0,0" DockPanel.Dock="Right" Click="ImportScreenshot_Click"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="100" IsCancel="True"/>
            <Button Content="生成 XML" Width="120" IsDefault="True" Click="Generate_Click"/>
        </StackPanel>
    </Grid>
</Window>

