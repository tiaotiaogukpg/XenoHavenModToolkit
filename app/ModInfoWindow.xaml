<Window x:Class="XenoHavenModToolkit.ModInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑MOD" Height="700" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="16" Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModFormLabelCol" MaxWidth="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="id" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="MOD 基础值，创建后不可改"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" Margin="0,0,0,8" MinHeight="32" IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="steamPublishedFileId" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="Steam 创意工坊 ID，无则为 0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SteamPublishedFileIdBox" Margin="0,0,0,8" MinHeight="32"
                         Text="0" IsReadOnly="True" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="SupportVersion" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="固定为 1，不可改"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SupportVersionBox" Text="1" Margin="0,0,0,8" MinHeight="32"
                         IsReadOnly="True" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="name" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="auth" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="AuthorBox" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="version" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="VersionBox" Text="1.0.0" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="specifications" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="SpecBox" Text="0.0.1" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Category" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="用于总览树分类显示"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="CategoryBox" Text="Building" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="description" Style="{DynamicResource BuildingEditorLabelStyle}"
                           VerticalAlignment="Top" Margin="0,6,10,0" ToolTip="必填"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="DescriptionBox"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         MinHeight="120"
                         Margin="0,0,0,8"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="icon.png" Style="{DynamicResource BuildingEditorLabelStyle}"
                           VerticalAlignment="Center" ToolTip="MOD 图标，保存到 MOD 根目录"/>
                <DockPanel Grid.Row="9" Grid.Column="1" Margin="0,0,0,8" MinHeight="32">
                    <Button Content="导入/替换" Width="100" Margin="8,0,0,0" DockPanel.Dock="Right" Click="ImportIcon_Click"/>
                    <TextBlock x:Name="IconPathText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="screenshot.png" Style="{DynamicResource BuildingEditorLabelStyle}"
                           VerticalAlignment="Center" ToolTip="MOD 截图，保存到 MOD 根目录"/>
                <DockPanel Grid.Row="10" Grid.Column="1" MinHeight="32">
                    <Button Content="导入/替换" Width="100" Margin="8,0,0,0" DockPanel.Dock="Right" Click="ImportScreenshot_Click"/>
                    <TextBlock x:Name="ScreenshotPathText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="100" IsCancel="True"/>
            <Button Content="保存" Width="120" IsDefault="True" Click="Generate_Click"/>
        </StackPanel>
    </Grid>
</Window>
