<Window x:Class="XenoHavenModToolkit.NewModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.NewMod.Title}" Height="700" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Window.Resources>
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1177BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1177BB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#0B4F7A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16" Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModFormLabelCol" MaxWidth="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="id" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="{DynamicResource Str.NewMod.IdTip}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" Margin="0,0,0,8" MinHeight="32" IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="steamPublishedFileId" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SteamPublishedFileIdBox" Margin="0,0,0,8" MinHeight="32"
                         Text="0" IsReadOnly="True" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="supportVersion" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SupportVersionBox" Text="1" Margin="0,0,0,8" MinHeight="32"
                         IsReadOnly="True" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="name" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="auth" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="AuthorBox" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="version" Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="{DynamicResource Str.NewMod.VersionTip}"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="VersionBox" Text="1.0.0" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"
                         ToolTip="{DynamicResource Str.NewMod.VersionTip}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="category" Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="CategoryBox" Text="Building" Margin="0,0,0,8" MinHeight="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="description" Style="{DynamicResource BuildingEditorLabelStyle}"
                           VerticalAlignment="Top" Margin="0,6,10,0" ToolTip="{DynamicResource Str.NewMod.DescriptionRequiredTip}"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="DescriptionBox"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         MinHeight="120"
                         Margin="0,0,0,8"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="icon.png" Style="{DynamicResource BuildingEditorLabelStyle}"
                           VerticalAlignment="Center"/>
                <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" MinHeight="32">
                    <Button Content="{DynamicResource Str.Import}" Width="90" Margin="8,0,0,0" DockPanel.Dock="Right" Click="ImportIcon_Click"/>
                    <TextBlock x:Name="IconPathText"
                               Text="{DynamicResource Str.NotSelected}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="screenshot.png" Style="{DynamicResource BuildingEditorLabelStyle}"
                           VerticalAlignment="Center"/>
                <DockPanel Grid.Row="9" Grid.Column="1" MinHeight="32">
                    <Button Content="{DynamicResource Str.Import}" Width="90" Margin="8,0,0,0" DockPanel.Dock="Right" Click="ImportScreenshot_Click"/>
                    <TextBlock x:Name="ScreenshotPathText"
                               Text="{DynamicResource Str.NotSelected}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Str.Create}" Width="120" IsDefault="True" Click="Create_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>
            <Button Content="{DynamicResource Str.Cancel}" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
