<Window x:Class="XenoHavenModToolkit.NewModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建 Mod" Height="520" Width="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="文件夹名（总览目录下的子文件夹）" Margin="0,0,0,6"/>
                <TextBox x:Name="FolderNameBox" Margin="0,0,0,14"/>

                <TextBlock Text="name" Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,14"/>

                <TextBlock Text="auth" Margin="0,0,0,6"/>
                <TextBox x:Name="AuthorBox" Margin="0,0,0,14"/>

                <TextBlock Text="version" Margin="0,0,0,6"/>
                <TextBox x:Name="VersionBox" Text="1.0.0" Margin="0,0,0,14"/>

                <TextBlock Text="specifications" Margin="0,0,0,6"/>
                <TextBox x:Name="SpecBox" Text="0.0.1" Margin="0,0,0,14"/>

                <TextBlock Text="description" Margin="0,0,0,6"/>
                <TextBox x:Name="DescriptionBox"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         MinHeight="180"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="100" IsCancel="True"/>
            <Button Content="创建" Width="120" IsDefault="True" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>

