<Window x:Class="XenoHavenModToolkit.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Settings.Title}"
        Height="280"
        Width="460"
        MinHeight="240"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="16" Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <CheckBox x:Name="OpenLastModCheck"
                      Content="{DynamicResource Str.Settings.OpenLastMod}"
                      Margin="0,0,0,12"
                      Foreground="{DynamicResource Theme.TextColor}"/>

            <!-- 隐藏开关：默认关闭，用于对外隐藏 Dynamic / 农业傀儡开发功能 -->
            <Border x:Name="AdvancedPanel"
                    BorderBrush="{DynamicResource Theme.BorderColor}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,4,0,0"
                    Background="{DynamicResource Theme.PanelBackground}"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Settings.Advanced}"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               FontSize="12"
                               Margin="0,0,0,8"/>
                    <CheckBox x:Name="EnableDynamicDevCheck"
                              Content="{DynamicResource Str.Settings.EnableDynamicDev}"
                              ToolTip="{DynamicResource Str.Settings.EnableDynamicDevTip}"
                              Foreground="{DynamicResource Theme.TextColor}"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="UnlockHintText"
                       Text="{DynamicResource Str.Settings.UnlockHint}"
                       Margin="0,12,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource Theme.SecondaryTextColor}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Str.Save}" Width="100" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="{DynamicResource Str.Cancel}" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
