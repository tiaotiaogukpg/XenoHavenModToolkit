<Window x:Class="XenoHavenModToolkit.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="320" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="16" Background="{DynamicResource Theme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="保存位置" Margin="0,0,0,8" FontWeight="SemiBold"/>

            <Border Background="{DynamicResource Theme.PanelBackground}"
                    BorderBrush="{DynamicResource Theme.BorderColor}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="将 Mod 总览目录（包含多个 Mod 文件夹）保存到"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               x:Name="OverviewRootPathText"
                               Margin="0,6,12,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextColor}"/>

                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            Content="更改存储路径"
                            MinWidth="120"
                            Click="Browse_Click"/>
                </Grid>
            </Border>

            <!-- 兼容旧代码：作为数据载体，不展示 -->
            <TextBox x:Name="OverviewRootBox" Visibility="Collapsed"/>

            <CheckBox x:Name="OpenLastModCheck" Content="启动时自动打开上次的 Mod"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="保存" Width="120" IsDefault="True" Click="Save_Click"/>
            <Button Content="取消" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

