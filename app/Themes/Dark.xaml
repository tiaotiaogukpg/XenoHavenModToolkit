<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Theme.WindowBackgroundColor">#1E1E1E</Color>
    <Color x:Key="Theme.PanelBackgroundColor">#252526</Color>
    <Color x:Key="Theme.EditorBackgroundColor">#1E1E1E</Color>
    <Color x:Key="Theme.TextColorValue">#D4D4D4</Color>
    <Color x:Key="Theme.SecondaryTextColorValue">#A6A6A6</Color>
    <Color x:Key="Theme.BorderColorValue">#3C3C3C</Color>
    <Color x:Key="Theme.ButtonBackgroundColor">#333333</Color>
    <Color x:Key="Theme.ButtonHoverBackgroundColor">#3E3E42</Color>
    <Color x:Key="Theme.ButtonTextColorValue">#D4D4D4</Color>
    <Color x:Key="Theme.TabBackgroundColor">#2D2D30</Color>
    <Color x:Key="Theme.TabActiveBackgroundColor">#1E1E1E</Color>
    <Color x:Key="Theme.ConsoleBackgroundColor">#1E1E1E</Color>
    <Color x:Key="Theme.ConsoleTextColorValue">#D4D4D4</Color>
    <Color x:Key="Theme.SelectionBackgroundColor">#094771</Color>
    <Color x:Key="Theme.FocusGlowColor">#3FA9F5</Color>

    <SolidColorBrush x:Key="Theme.WindowBackground" Color="{StaticResource Theme.WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="Theme.PanelBackground" Color="{StaticResource Theme.PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="Theme.EditorBackground" Color="{StaticResource Theme.EditorBackgroundColor}"/>
    <SolidColorBrush x:Key="Theme.TextColor" Color="{StaticResource Theme.TextColorValue}"/>
    <SolidColorBrush x:Key="Theme.SecondaryTextColor" Color="{StaticResource Theme.SecondaryTextColorValue}"/>
    <SolidColorBrush x:Key="Theme.BorderColor" Color="{StaticResource Theme.BorderColorValue}"/>
    <SolidColorBrush x:Key="Theme.ButtonBackground" Color="{StaticResource Theme.ButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="Theme.ButtonHoverBackground" Color="{StaticResource Theme.ButtonHoverBackgroundColor}"/>
    <SolidColorBrush x:Key="Theme.ButtonTextColor" Color="{StaticResource Theme.ButtonTextColorValue}"/>
    <SolidColorBrush x:Key="Theme.TabBackground" Color="{StaticResource Theme.TabBackgroundColor}"/>
    <SolidColorBrush x:Key="Theme.TabActiveBackground" Color="{StaticResource Theme.TabActiveBackgroundColor}"/>
    <SolidColorBrush x:Key="Theme.ConsoleBackground" Color="{StaticResource Theme.ConsoleBackgroundColor}"/>
    <SolidColorBrush x:Key="Theme.ConsoleTextColor" Color="{StaticResource Theme.ConsoleTextColorValue}"/>
    <SolidColorBrush x:Key="Theme.SelectionBackground" Color="{StaticResource Theme.SelectionBackgroundColor}"/>
    <SolidColorBrush x:Key="Theme.FocusGlow" Color="{StaticResource Theme.FocusGlowColor}"/>
    <SolidColorBrush x:Key="Theme.TreeViewLineBrush" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="Theme.TreeViewHoverBackground" Color="#2D3133"/>
    <SolidColorBrush x:Key="Theme.TreeViewModValidForeground" Color="#FF6B6B"/>
</ResourceDictionary>
