<Window x:Class="XenoHavenModToolkit.WorkshopUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="上传到创意工坊"
        Height="560" Width="640"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="WorkshopLabelCol" MaxWidth="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="模式"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ModeText"
                           Margin="0,0,0,8" VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="PublishedFileId"
                           Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="创意工坊条目 ID（steamPublishedFileId）"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PublishedFileIdBox"
                         Margin="0,0,0,8" MinHeight="32" IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="标题"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TitleBox"
                         Margin="0,0,0,8" MinHeight="32"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="简介"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="DescriptionBox"
                         Margin="0,0,0,8" MinHeight="96"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="更新说明"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="ChangeNoteBox"
                         Margin="0,0,0,8" MinHeight="32"
                         VerticalContentAlignment="Center"
                         Text="Update"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="可见性"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="VisibilityBox"
                          Margin="0,0,0,8" MinHeight="32"
                          SelectedIndex="0">
                    <ComboBoxItem Content="公开" Tag="Public"/>
                    <ComboBoxItem Content="仅好友" Tag="FriendsOnly"/>
                    <ComboBoxItem Content="私有" Tag="Private"/>
                </ComboBox>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="预览图"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="PreviewPathBox"
                         Margin="0,0,0,8" MinHeight="32" IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="内容目录"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="ContentPathBox"
                         Margin="0,0,0,8" MinHeight="32" IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <CheckBox Grid.Row="8" Grid.Column="1" x:Name="ExcludeMetaCheck"
                          Content="上传时排除 .meta 文件"
                          IsChecked="True" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="进度"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,0,0,4">
                    <TextBlock x:Name="ProgressText" Text="等待开始…"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ProgressBar"
                                 Height="12" Margin="0,6,0,0"
                                 Minimum="0" Maximum="100" Value="0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="1" x:Name="StatusText"
                   Margin="0,8,0,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button x:Name="OpenItemButton"
                    DockPanel.Dock="Left"
                    Content="打开工坊页"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    IsEnabled="False"
                    Click="OpenItem_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="UploadButton"
                        Content="开始上传"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Click="Upload_Click"/>
                <Button x:Name="CloseButton"
                        Content="关闭"
                        Padding="12,6"
                        IsCancel="True"
                        Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
