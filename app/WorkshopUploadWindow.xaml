<Window x:Class="XenoHavenModToolkit.WorkshopUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Workshop.Title}"
        Height="560" Width="640"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="WorkshopLabelCol" MaxWidth="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str.Workshop.Mode}"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ModeText"
                           Margin="0,0,0,8" VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="PublishedFileId"
                           Style="{DynamicResource BuildingEditorLabelStyle}"
                           ToolTip="{DynamicResource Str.Workshop.PublishedFileIdTip}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PublishedFileIdBox"
                         Margin="0,0,0,8" MinHeight="32" IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str.Workshop.TitleLabel}"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TitleBox"
                         Margin="0,0,0,8" MinHeight="32"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Str.Workshop.DescriptionLabel}"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="DescriptionBox"
                         Margin="0,0,0,8" MinHeight="96"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Str.Workshop.ChangeNote}"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="ChangeNoteBox"
                         Margin="0,0,0,8" MinHeight="32"
                         VerticalContentAlignment="Center"
                         Text="Update"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Str.Workshop.Visibility}"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="VisibilityBox"
                          Margin="0,0,0,8" MinHeight="32"
                          SelectedIndex="0">
                    <ComboBoxItem Content="{DynamicResource Str.Workshop.VisibilityPublic}" Tag="Public"/>
                    <ComboBoxItem Content="{DynamicResource Str.Workshop.VisibilityFriends}" Tag="FriendsOnly"/>
                    <ComboBoxItem Content="{DynamicResource Str.Workshop.VisibilityPrivate}" Tag="Private"/>
                </ComboBox>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Str.Workshop.Preview}"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="PreviewPathBox"
                         Margin="0,0,0,8" MinHeight="32" IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource Str.Workshop.Content}"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="ContentPathBox"
                         Margin="0,0,0,8" MinHeight="32" IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

                <CheckBox Grid.Row="8" Grid.Column="1" x:Name="ExcludeMetaCheck"
                          Content="{DynamicResource Str.Workshop.ExcludeMeta}"
                          IsChecked="True" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource Str.Workshop.Progress}"
                           Style="{DynamicResource BuildingEditorLabelStyle}"/>
                <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,0,0,4">
                    <TextBlock x:Name="ProgressText" Text="{DynamicResource Str.Workshop.Waiting}"
                               Foreground="{DynamicResource Theme.SecondaryTextColor}"
                               TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ProgressBar"
                                 Height="12" Margin="0,6,0,0"
                                 Minimum="0" Maximum="100" Value="0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="1" x:Name="StatusText"
                   Margin="0,8,0,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Theme.SecondaryTextColor}"/>

        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button x:Name="OpenItemButton"
                    DockPanel.Dock="Left"
                    Content="{DynamicResource Str.Workshop.OpenItem}"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    IsEnabled="False"
                    Click="OpenItem_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="UploadButton"
                        Content="{DynamicResource Str.Workshop.StartUpload}"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Click="Upload_Click"/>
                <Button x:Name="CloseButton"
                        Content="{DynamicResource Str.Close}"
                        Padding="12,6"
                        IsCancel="True"
                        Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
