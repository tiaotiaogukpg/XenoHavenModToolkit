<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>XenoHavenModTool</AssemblyName>
    <RootNamespace>XenoHavenModToolkit</RootNamespace>
    <Product>XenoHavenModTool</Product>
    <Company>XenoHaven</Company>
    <!-- 发版时只改这里；About / 窗口标题 / 文件属性会一起更新 -->
    <Version>0.3.1</Version>
    <AssemblyVersion>0.3.1.0</AssemblyVersion>
    <FileVersion>0.3.1.0</FileVersion>
    <InformationalVersion>0.3.1</InformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);STEAMWORKS_WIN;STEAMWORKS_X64</DefineConstants>
    <NoWarn>$(NoWarn);CS8765;CS8625;CS8618;CS8601;CS8600;CS8604;CS8605;CS8603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.10.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\third_party\Steamworks.NET\Runtime\**\*.cs" Link="Steamworks\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\DOC\*.xlsx" Link="DOC\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Mods\**\*" Exclude="..\Mods\**\*.meta;..\Mods\**\.gitkeep;..\Mods\**\steamPublishedFileId.id" Link="Mods\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\templates\FarmingGolem\**\*" Link="templates\FarmingGolem\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- steam_appid.txt 不随发布包分发；运行时由 SteamSession 按需写入。 -->
    <None Include="..\third_party\Steamworks.NET\native\win-x64\steam_api64.dll"
          Link="steam_api64.dll"
          CopyToOutputDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
